# Copie para .env e preencha antes de rodar os scripts (não commitar o .env real).
# O .env está no .gitignore — nunca versione tokens reais.

# --- GitHub ---------------------------------------------------------------
# Personal Access Token do GitHub, escopo 'repo' (ou 'public_repo' se só
# repositórios públicos). Usado pelos scripts 02/04/05.
GITHUB_TOKEN=

# Vários tokens separados por vírgula, para rotação (multiplica o teto de
# 30 req/min da Search API por token). Tem prioridade sobre GITHUB_TOKEN se
# ambos estiverem definidos. Ver ubw/github_api.py.
#   GITHUB_TOKENS=tok1,tok2,tok3
GITHUB_TOKENS=

# --- Pré-triagem por LLM (script 03, opcional) ----------------------------
# Backend Anthropic (--provider anthropic):
ANTHROPIC_API_KEY=

# Backend OpenRouter (--provider openrouter), alternativa de baixo custo:
OPENROUTER_API_KEY=

# --- SEART-GHS (script 01, opcional) --------------------------------------
# Endpoint de busca, caso precise apontar para um espelho ou versão futura.
SEART_BASE_URL=https://seart-ghs.si.usi.ch/api/r/search
